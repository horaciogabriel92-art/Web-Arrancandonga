        </button>
        <img id="modalImage" src="" alt="" class="max-w-full max-h-[85vh] rounded-2xl border-4 border-white" />
        <p id="modalCaption" class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-white px-4 py-2 rounded-full border-2 border-brandDark font-bold text-brandDark"></p>
    </div>

    {/* Modal para el Feed de Instagram */}
    <div id="feedModal" class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4">
        <button id="closeFeedModalBtn" class="absolute top-4 right-4 w-12 h-12 bg-white rounded-full border-4 border-brandDark flex items-center justify-center text-2xl hover:bg-brandPink transition-colors z-10">
            ✕
        </button>
        <button id="prevFeedBtn" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-white rounded-full border-4 border-brandDark flex items-center justify-center text-2xl hover:bg-brandYellow transition-colors z-10">
            ←
        </button>
        <button id="nextFeedBtn" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-white rounded-full border-4 border-brandDark flex items-center justify-center text-2xl hover:bg-brandYellow transition-colors z-10">
            →
        </button>
        <img id="feedModalImage" src="" alt="" class="max-w-full max-h-[85vh] rounded-2xl border-4 border-white" />
        <p id="feedModalCaption" class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-white px-4 py-2 rounded-full border-2 border-brandDark font-bold text-brandDark"></p>
    </div>

    <script define:vars={{ images, title: project.title, socialFeed: project.socialFeed || [] }}>
        const modal = document.getElementById('imageModal');
        const modalImage = document.getElementById('modalImage');
        const modalCaption = document.getElementById('modalCaption');
        const closeBtn = document.getElementById('closeModalBtn');
        const prevBtn = document.getElementById('prevImageBtn');
        const nextBtn = document.getElementById('nextImageBtn');
        const triggers = document.querySelectorAll('.modal-trigger');
        
        let currentIndex = 0;

        function openModal(index) {
            currentIndex = index;
            modalImage.src = images[index];
            modalCaption.textContent = title + ' - Imagen ' + (index + 1);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }

        function nextImage() {
            currentIndex = (currentIndex + 1) % images.length;
            modalImage.src = images[currentIndex];
            modalCaption.textContent = title + ' - Imagen ' + (currentIndex + 1);
        }

        function prevImage() {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            modalImage.src = images[currentIndex];
            modalCaption.textContent = title + ' - Imagen ' + (currentIndex + 1);
        }

        // Event listeners
        triggers.forEach(trigger => {
            trigger.addEventListener('click', () => {
                const index = parseInt(trigger.getAttribute('data-index'));
                openModal(index);
            });
        });

        closeBtn.addEventListener('click', closeModal);
        prevBtn.addEventListener('click', prevImage);
        nextBtn.addEventListener('click', nextImage);

        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
            if (e.key === 'ArrowRight') nextImage();
            if (e.key === 'ArrowLeft') prevImage();
        });

        // Modal del Feed de Instagram
        if (socialFeed.length > 0) {
            const feedModal = document.getElementById('feedModal');
            const feedModalImage = document.getElementById('feedModalImage');
            const feedModalCaption = document.getElementById('feedModalCaption');
            const closeFeedBtn = document.getElementById('closeFeedModalBtn');
            const prevFeedBtn = document.getElementById('prevFeedBtn');
            const nextFeedBtn = document.getElementById('nextFeedBtn');
            const feedTriggers = document.querySelectorAll('.social-feed-item');
            
            let currentFeedIndex = 0;

            function openFeedModal(index) {
                currentFeedIndex = index;
                feedModalImage.src = socialFeed[index];
                feedModalCaption.textContent = 'Feed de Instagram - Imagen ' + (index + 1);
                feedModal.classList.remove('hidden');
                feedModal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }

            function closeFeedModal() {
                feedModal.classList.add('hidden');
                feedModal.classList.remove('flex');
                document.body.style.overflow = '';
            }

            function nextFeedImage() {
                currentFeedIndex = (currentFeedIndex + 1) % socialFeed.length;
                feedModalImage.src = socialFeed[currentFeedIndex];
                feedModalCaption.textContent = 'Feed de Instagram - Imagen ' + (currentFeedIndex + 1);
            }

            function prevFeedImage() {
                currentFeedIndex = (currentFeedIndex - 1 + socialFeed.length) % socialFeed.length;
                feedModalImage.src = socialFeed[currentFeedIndex];
                feedModalCaption.textContent = 'Feed de Instagram - Imagen ' + (currentFeedIndex + 1);
            }

            feedTriggers.forEach((trigger, idx) => {
                trigger.addEventListener('click', () => openFeedModal(idx));
            });

            closeFeedBtn.addEventListener('click', closeFeedModal);
            prevFeedBtn.addEventListener('click', prevFeedImage);
            nextFeedBtn.addEventListener('click', nextFeedImage);

            feedModal.addEventListener('click', (e) => {
                if (e.target === feedModal) closeFeedModal();
            });
        }

        // Carrusel Circular 3D de Reels
        const reelsContainer = document.getElementById('reelsContainer');
        const reelsPrev = document.getElementById('reelsPrev');
        const reelsNext = document.getElementById('reelsNext');
        const reelCards = document.querySelectorAll('.reel-card');
        const reelIndicators = document.querySelectorAll('.reels-indicator');
        
        if (reelsContainer && reelsPrev && reelsNext && reelCards.length > 0) {
            let currentReelIndex = 0;
            const totalReels = reelCards.length;
            const angleStep = 360 / totalReels;
            
            function updateCarousel() {
                reelCards.forEach((card, i) => {
                    const offset = i - currentReelIndex;
                    let angle = offset * angleStep;
                    
                    // Normalizar ángulo para que esté entre -180 y 180
                    if (angle > 180) angle -= 360;
                    if (angle < -180) angle += 360;
                    
                    // Calcular posición y escala
                    const isActive = i === currentReelIndex;
                    const absAngle = Math.abs(angle);
                    
                    let translateZ = 200;
                    let scale = 0.7;
                    let opacity = 0.5;
                    let zIndex = 10 - absAngle;
                    
                    if (isActive) {
                        translateZ = 280;
                        scale = 1;
                        opacity = 1;
                        zIndex = 20;
                    } else if (absAngle <= angleStep * 1.5) {
                        // Tarjetas cercanas
                        translateZ = 200 - (absAngle * 0.5);
                        scale = 0.75;
                        opacity = 0.7;
                        zIndex = 15 - Math.floor(absAngle / angleStep);
                    }
                    
                    card.style.transform = `rotateY(${angle}deg) translateZ(${translateZ}px) scale(${scale})`;
                    card.style.opacity = opacity;
                    card.style.zIndex = zIndex;
                    
                    // Añadir/quitar clase activa
                    if (isActive) {
                        card.classList.add('active');
                    } else {
                        card.classList.remove('active');
                    }
                });
                
                // Actualizar indicadores
                reelIndicators.forEach((ind, i) => {
                    if (i === currentReelIndex) {
                        ind.classList.add('bg-brandPink', 'w-8');
                        ind.classList.remove('bg-white');
                    } else {
                        ind.classList.remove('bg-brandPink', 'w-8');
                        ind.classList.add('bg-white');
                    }
                });
            }
            
            // Inicializar
            reelsContainer.style.transformStyle = 'preserve-3d';
            reelsContainer.style.perspective = '1000px';
            updateCarousel();
            
            // Navegación con botones
            reelsPrev.addEventListener('click', () => {
                currentReelIndex = (currentReelIndex - 1 + totalReels) % totalReels;
                updateCarousel();
            });
            
            reelsNext.addEventListener('click', () => {
                currentReelIndex = (currentReelIndex + 1) % totalReels;
                updateCarousel();
            });
            
            // Click en tarjeta para activarla
            reelCards.forEach((card, i) => {
                card.addEventListener('click', () => {
                    if (i !== currentReelIndex) {
                        currentReelIndex = i;
                        updateCarousel();
                    }
                });
            });
            
            // Touch/Swipe support
            let touchStartX = 0;
            let touchStartY = 0;
            
            reelsContainer.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
                touchStartY = e.changedTouches[0].screenY;
            }, { passive: true });
            
            reelsContainer.addEventListener('touchend', (e) => {
                const touchEndX = e.changedTouches[0].screenX;
                const touchEndY = e.changedTouches[0].screenY;
                const diffX = touchStartX - touchEndX;
                const diffY = touchStartY - touchEndY;
                
                // Solo si el swipe es más horizontal que vertical
                if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
                    if (diffX > 0) {
                        // Swipe left - next
                        currentReelIndex = (currentReelIndex + 1) % totalReels;
                    } else {
                        // Swipe right - prev
                        currentReelIndex = (currentReelIndex - 1 + totalReels) % totalReels;
                    }
                    updateCarousel();
                }
            }, { passive: true });
            
            // Navegación con indicadores
            reelIndicators.forEach((ind, i) => {
                ind.addEventListener('click', () => {
                    currentReelIndex = i;
                    updateCarousel();
                });
            });
            
            // Modal para reproducir reels
            const reelModal = document.getElementById('reelModal');
            const reelIframe = document.getElementById('reelIframe');
            const closeReelModalBtn = document.getElementById('closeReelModalBtn');
            
            function openReelModal(url) {
                // Convertir URL de Instagram a URL de embed
                const embedUrl = url.replace('/p/', '/p/') + 'embed/';
                reelIframe.src = embedUrl;
                reelModal.classList.remove('hidden');
                reelModal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            }
            
            function closeReelModal() {
                reelModal.classList.add('hidden');
                reelModal.classList.remove('flex');
                reelIframe.src = '';
                document.body.style.overflow = '';
            }
            
            // Click en el botón de play del reel activo
            reelCards.forEach((card) => {
                const playBtn = card.querySelector('.reel-play-btn');
                const urlDiv = card.querySelector('.reel-url');
                
                if (playBtn && urlDiv) {
                    playBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const url = urlDiv.getAttribute('data-url');
                        if (url) {
                            openReelModal(url);
                        }
                    });
                }
            });
            
            closeReelModalBtn.addEventListener('click', closeReelModal);
            reelModal.addEventListener('click', (e) => {
                if (e.target === reelModal) closeReelModal();
            });
            
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !reelModal.classList.contains('hidden')) {
                    closeReelModal();
                }
            });
        }
        
        // Carruseles Instagram
        const carouselDataElements = document.querySelectorAll('.carousel-data');
        
        carouselDataElements.forEach(dataEl => {
            const carouselIndex = dataEl.getAttribute('data-carousel');
            const images = JSON.parse(dataEl.getAttribute('data-images') || '[]');
            const container = dataEl.closest('.bg-white');
            const mainImage = container.querySelector('.carousel-main-image');
            const prevBtn = container.querySelector('.carousel-prev');
            const nextBtn = container.querySelector('.carousel-next');
            const dots = container.querySelectorAll('.carousel-dot');
            const counter = container.querySelector('.absolute.top-3.right-3');
            
            let currentImageIndex = 0;
            
            function updateCarouselImage() {
                mainImage.src = images[currentImageIndex];
                mainImage.setAttribute('data-index', currentImageIndex);
                
                // Update dots
                dots.forEach((dot, idx) => {
                    if (idx === currentImageIndex) {
                        dot.classList.remove('bg-white/50');
                        dot.classList.add('bg-white');
                    } else {
                        dot.classList.remove('bg-white');
                        dot.classList.add('bg-white/50');
                    }
                });
                
                // Update counter
                if (counter) {
                    counter.textContent = `${currentImageIndex + 1} / ${images.length}`;
                }
            }
            
            if (prevBtn) {
                prevBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    currentImageIndex = (currentImageIndex - 1 + images.length) % images.length;
                    updateCarouselImage();
                });
            }
            
            if (nextBtn) {
                nextBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    currentImageIndex = (currentImageIndex + 1) % images.length;
                    updateCarouselImage();
                });
            }
            
            // Click on image to open modal
            mainImage.addEventListener('click', () => {
                const allImages = [...images];
                const index = currentImageIndex;
                
                // Create modal content
                modalImage.src = allImages[index];
                modalCaption.textContent = `${dataEl.getAttribute('data-title')} - Imagen ${index + 1}`;
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
                
                // Update modal navigation
                const modalPrev = document.getElementById('prevImageBtn');
                const modalNext = document.getElementById('nextImageBtn');
                
                const modalPrevHandler = () => {
                    currentImageIndex = (currentImageIndex - 1 + allImages.length) % allImages.length;
                    modalImage.src = allImages[currentImageIndex];
                    modalCaption.textContent = `${dataEl.getAttribute('data-title')} - Imagen ${currentImageIndex + 1}`;
                    updateCarouselImage();
                };
                
                const modalNextHandler = () => {
                    currentImageIndex = (currentImageIndex + 1) % allImages.length;
                    modalImage.src = allImages[currentImageIndex];
                    modalCaption.textContent = `${dataEl.getAttribute('data-title')} - Imagen ${currentImageIndex + 1}`;
                    updateCarouselImage();
                };
                
                modalPrev.onclick = modalPrevHandler;
                modalNext.onclick = modalNextHandler;
            });
        });
    </script>
</Layout>
